{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "AdminUsers": "admin",
    "TimeoutSeconds": 60,
    "UserMinuteLimit": 20,
    "UserDailyLimit": 1000,
    "LogContent": false
  },
  "Paging": {
    "DefaultPageSize": 20,
    "MaxPageSize": 500,
    "MaxPage": 100000
  },
  "Admin": {
    "Bootstrap": {
      "UserName": "admin",
      "Password": "<首个超级管理员引导账号放 appsettings.Development.json（gitignore）或用户机密，不进仓库>"
    }
  },
  "XiHan": {
    // 框架 AI 子系统：模型凭据**不在这里**（本项目从 LlmProviderConfig 表读，Key 加密），
    // 由 DbAIProviderCatalog 覆盖框架默认的配置驱动目录。这里只放框架层面的安全开关。
    "AI": {
      // 内置护栏：输入侧检查提示注入（"ignore previous instructions" 等中英文模式）。
      // BlockedKeywords 留空 = 只启用注入启发式；要禁用的词按需补。
      // 护栏拦截时 AIIChat 返回 AI_DENIED_001（403），details 带 guardrail 与 reason。
      "Guardrails": {
        "Enabled": true,
        "BlockedKeywords": []
      }
    },
    "Bindings": {
      "db": "Server=localhost;Database=AuthBaseXiHanDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
    },
    // 内全局限流：按进程、按操作 ID 计数，由内核 ResilienceMiddleware 在管道 Resilience 阶段执行，
    // 超限返回 503 KERNEL_UNAVAILABLE_002（details 带 retryAfter）。零代码，只写配置。
    // 这一层是兜底——防止某个脚本或 bug 把上游额度瞬间打爆；真正的业务配额是按用户的
    // Ai:UserMinuteLimit / Ai:UserDailyLimit。并发上限单独设，避免慢请求堆积把线程占满。
    "Kernel": {
      "Resilience": {
        "Operations": {
          "ai.chat": {
            "PermitLimit": 600,
            "WindowSeconds": 60,
            "ConcurrencyLimit": 16
          }
        }
      }
    },
    "Security": {
      "Jwt": {
        "Secret": "<至少 32 字节随机密钥，本机开发配置放 appsettings.Development.json（gitignore）或用户机密，不进仓库>",
        "Issuer": "authbase",
        "Audience": "authbase-api",
        "ClockSkewSeconds": 60
      }
    },
    "Persistence": {
      "EntityFrameworkCore": {
        "EnsureCreated": true
      }
    },
    "Localization": {
      "DefaultLocale": "zh-CN",
      "Locales": "zh-CN,en-US"
    },
    "Caching": {
      "Redis": {
        "Configuration": "127.0.0.1:6379,<Redis 密码放 appsettings.Development.json（gitignore），不进仓库>,abortConnect=false",
        "KeyPrefix": "authbase:",
        "DefaultTimeToLiveSeconds": 604800
      }
    }
  }
}
