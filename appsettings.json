{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "AdminUsers": "admin"
  },
  "Paging": {
    "DefaultPageSize": 20,
    "MaxPageSize": 500,
    "MaxPage": 100000
  },
  "Admin": {
    "Bootstrap": {
      "UserName": "admin",
      "Password": "<首个超级管理员引导账号放 appsettings.Development.json（gitignore）或用户机密，不进仓库>"
    }
  },
  "XiHan": {
    "Bindings": {
      "db": "Server=localhost;Database=AuthBaseXiHanDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
    },
    "Security": {
      "Jwt": {
        "Secret": "<至少 32 字节随机密钥，本机开发配置放 appsettings.Development.json（gitignore）或用户机密，不进仓库>",
        "Issuer": "authbase",
        "Audience": "authbase-api",
        "ClockSkewSeconds": 60
      }
    },
    "Persistence": {
      "EntityFrameworkCore": {
        "EnsureCreated": true
      }
    },
    "Localization": {
      "DefaultLocale": "zh-CN",
      "Locales": "zh-CN,en-US"
    },
    "Caching": {
      "Redis": {
        "Configuration": "127.0.0.1:6379,<Redis 密码放 appsettings.Development.json（gitignore），不进仓库>,abortConnect=false",
        "KeyPrefix": "authbase:",
        "DefaultTimeToLiveSeconds": 604800
      }
    }
  }
}
