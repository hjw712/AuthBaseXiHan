<?xml version="1.0" encoding="utf-8"?>
<!--
  卷影复制（ANCM Shadow Copy）配置说明见 README「部署：卷影复制与无感更新」章节。
  发布时 SDK 会以此文件为模板合并（注入环境变量等），不会覆盖这里的 shadow copy 属性。
  前置条件：服务器 Hosting Bundle >= 7.0（本机为 10.x/11.x）；目录权限由 deploy-shadowcopy.ps1 配置。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        enableShadowCopy        : true 让 ANCM 把程序集复制到独立目录运行，源目录 DLL 不再被锁定，发布可直接覆盖
        shadowCopyDirectory     : 卷影目录，用 .. 放到站点目录之外，避免发布/WebDeploy 时把它当作站点内容同步或删除
        cleanShadowCopyDirectory: 启动时先清理再复制，避免升级 .NET 版本后残留旧程序集导致 500.30
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\AuthBaseXiHan.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  enableShadowCopy="true"
                  shadowCopyDirectory="..\AuthBaseXiHan_ShadowCopy"
                  cleanShadowCopyDirectory="true" />
    </system.webServer>
  </location>
</configuration>
