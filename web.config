<?xml version="1.0" encoding="utf-8"?>
<!--
  卷影复制（ANCM Shadow Copy）配置说明见 README「部署：卷影复制与无感更新」章节。
  发布时 SDK 会以此文件为模板合并（注入环境变量等），不会覆盖这里的 handlerSettings。
  前置条件：服务器 Hosting Bundle >= 7.0（本机为 10.x/11.x）；目录权限由 deploy-shadowcopy.ps1 配置。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        卷影复制必须写成 <handlerSettings> 子元素（<handlerSetting name="..." value="..." />），
        不是 <aspNetCore> 的 XML 属性——写成属性 ANCM 不识别，卷影复制不会生效。
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\AuthBaseXiHan.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <handlerSettings>
          <!-- 启用卷影复制：ANCM 复制程序集到独立目录运行，源目录 DLL 不再被锁定 -->
          <handlerSetting name="enableShadowCopy" value="true" />
          <!-- 副本目录用 .. 放到站点之外，避免发布/WebDeploy 同步或删除；应用池身份需有「修改」权限 -->
          <handlerSetting name="shadowCopyDirectory" value="..\AuthBaseXiHan_ShadowCopy\" />
          <!-- 启动时先清理再复制，避免升级 .NET 后残留旧程序集导致 500.30 -->
          <handlerSetting name="cleanShadowCopyDirectory" value="true" />
        </handlerSettings>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
