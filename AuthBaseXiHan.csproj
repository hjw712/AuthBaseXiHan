<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- OpenAPI 文档的字段说明来�?DTO �?XML 注释（Kernel.Generators 折进 Schema description�?-->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>cbe200ad-efc8-4972-87ba-e74dbe45ef42</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <!--
      AI 栈统一由 XiHan.Framework.AI 提供，不直接引用 Microsoft.Extensions.AI：
      ① 框架的 AI.Abstractions/OpenAI 依赖 Microsoft.Extensions.AI.Abstractions 10.11.0，
         直接钉 11.0.1 会让框架跑在比它测试时高一整个大版本的类型上（NuGet 取高版本）；
      ② 本项目只在 API 边界用 ChatMessage/ChatRole/IChatClient 这些抽象类型，
         它们随框架的 AI.Abstractions 传递进来即可，不必自持版本。
    -->
    <PackageReference Include="XiHan.Framework.AI.Abstractions" Version="5.0.0-rc.7" />
    <PackageReference Include="XiHan.Framework.AI.OpenAI" Version="5.0.0-rc.7" />
    <PackageReference Include="XiHan.Framework.Caching.Redis" Version="5.0.0-rc.7" />
    <PackageReference Include="XiHan.Framework.Kernel.Generators" Version="5.0.0-rc.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="XiHan.Framework.Persistence.EntityFrameworkCore" Version="5.0.0-rc.7" />
    <PackageReference Include="XiHan.Framework.Profiles.Minimal" Version="5.0.0-rc.7" />
    <PackageReference Include="XiHan.Framework.Protocols.Http" Version="5.0.0-rc.7" />
    <PackageReference Include="XiHan.Framework.Security.InMemory" Version="5.0.0-rc.7" />
    <PackageReference Include="XiHan.Framework.Security.Jwt" Version="5.0.0-rc.7" />
  </ItemGroup>

  <!-- 消息目录：接口文�?summary/description 与错误文案的翻译来源 -->
  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
